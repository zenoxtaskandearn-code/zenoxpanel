# Backend (Spring Boot)
SPRING_PROFILES_ACTIVE=prod
PORT=8080
SPRING_DATASOURCE_URL=jdbc:mysql://<host>:<port>/<database>?useSSL=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=<db_user>
SPRING_DATASOURCE_PASSWORD=<db_password>

# Security
JWT_SECRET=<long-random-secret-at-least-32-bytes>
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
JWT_DEVICE_ACCESS_MINUTES=60
ADMIN_REGISTRATION_ENABLED=false
ADMIN_REGISTRATION_INVITE_CODE=<optional-invite-code>

# CORS / WebSocket (comma-separated origins)
CORS_ALLOWED_ORIGINS=https://your-frontend.onrender.com
WS_ALLOWED_ORIGINS=https://your-frontend.onrender.com

# App behavior
RATE_LIMIT_RPM=120
OPERATION_EXPIRY_MINUTES=30

# Frontend (build-time)
VITE_API_BASE_URL=https://your-backend.onrender.com
